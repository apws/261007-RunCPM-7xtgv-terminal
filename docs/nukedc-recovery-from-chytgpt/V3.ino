        {0x08, 0x10, 0x10, 0x60, 0x10, 0x10, 0x08, 0x00, 0x00}, // 0x7B '{'
        {0x10, 0x10, 0x10, 0x00, 0x10, 0x10, 0x10, 0x00, 0x00}, // 0x7C '|'
        {0x20, 0x10, 0x10, 0x0C, 0x10, 0x10, 0x20, 0x00, 0x00}, // 0x7D '}'
        {0x00, 0x00, 0x34, 0x48, 0x00, 0x00, 0x00, 0x00, 0x00}, // 0x7E '~'
        {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00}, // 0x7F
    },

    // Bank 1
    {0},

    // Bank 2
    {0},

    // Bank 3
    {0}
};

// ===========================
// Cell compositor
// ===========================
//
// Composition order:
// 1) fill cellBuf with deep black
// 2) inverted PAPER glyph, from paperRAM, with paper color
// 3) normal INK glyph, from charRAM, with ink color
//
// Inversion:
// If glyph bit = 0, draw paper color.
// If glyph bit = 1, leave as-is: black or later ink.

static void composeCell565(
    uint8_t glyphset2,
    uint8_t paperGlyph,
    uint8_t inkGlyph,
    uint8_t paper2,
    uint8_t ink4)
{
    const uint16_t deepBlack =
    palette256[PAL_DEEPBLACK];

    const uint16_t paper565 =
    palette256[paperPalIndexFrom2(paper2)];

    const uint16_t ink565 =
    palette256[inkPalIndexFrom4(ink4)];

    const uint8_t gs =
    (uint8_t)(glyphset2 & 0x03);

    const uint8_t wmask =
    maskForCellW();

    // 1) Deep black
    for (uint16_t i = 0; i < CELL_PIXELS; i++)
    {
        cellBuf[i] = deepBlack;
    }

    // 2) Inverted paper glyph.
    // If bit is 0, paint paper color.
    {
        uint16_t* out = cellBuf;

        for (uint8_t y = 0; y < CELL_H; y++)
        {
            uint8_t bits =
            (uint8_t)(
                font1bpp[gs][paperGlyph][y] &
                wmask);

            for (uint8_t x = 0; x < CELL_W; x++)
            {
                uint8_t m =
                (uint8_t)(1u << (7 - x));

                if ((bits & m) == 0)
                {
                    out[x] = paper565;
                }
            }

            out += CELL_W;
        }
    }

    // 3) Ink glyph, normal.
    // If bit is 1, paint ink color.
    {
        uint16_t* out = cellBuf;

        for (uint8_t y = 0; y < CELL_H; y++)
        {
            uint8_t bits =
            (uint8_t)(
                font1bpp[gs][inkGlyph][y] &
                wmask);

            for (uint8_t x = 0; x < CELL_W; x++)
            {
                uint8_t m =
                (uint8_t)(1u << (7 - x));

                if (bits & m)
                {
                    out[x] = ink565;
                }
            }

            out += CELL_W;
        }
    }
}

static void renderFullScreen(GfxCompat& g)
{
    g.beginWrite();

    for (int cy = 0; cy < SCR_ROWS; cy++)
    {
        for (int cx = 0; cx < SCR_COLS; cx++)
        {
            const int idx =
            cy * SCR_COLS + cx;

            uint8_t attr =
            attrRAM[idx];

            uint8_t glyphset2 =
            (uint8_t)((attr >> 6) & 0x03);

            uint8_t paper2 =
            (uint8_t)((attr >> 4) & 0x03);

            uint8_t ink4 =
            (uint8_t)(attr & 0x0F);

            // Paper is a glyph index now.
            uint8_t paperGlyph =
            paperRAM[idx];

            uint8_t inkGlyph =
            charRAM[idx];

            composeCell565(
                glyphset2,
                paperGlyph,
                inkGlyph,
                paper2,
                ink4);

            int16_t px =
            (int16_t)(cx * CELL_W);

            int16_t py =
            (int16_t)(cy * CELL_H);

            g.blit565(
                px,
                py,
                CELL_W,
                CELL_H,
                cellBuf);
        }
    }

    g.endWrite();
}

// ===========================
// Demo setup content
// ===========================

static inline void setCell(
    int cx,
    int cy,
    uint8_t paperGlyph,
    uint8_t inkGlyph,
    uint8_t glyphset2,
    uint8_t paper2,
    uint8_t ink4)
{
    if ((unsigned)cx >= SCR_COLS ||
        (unsigned)cy >= SCR_ROWS)
    {
        return;
    }

    int idx =
    cy * SCR_COLS + cx;

    paperRAM[idx] =
    paperGlyph;

    charRAM[idx] =
    inkGlyph;

    attrRAM[idx] =
    (uint8_t)(
        ((glyphset2 & 3) << 6) |
        ((paper2 & 3) << 4) |
        (ink4 & 0x0F));
}

static void initScreenRAM()
{
    // Default:
    // paper glyph = space
    // ink glyph = space
    // attributes = ink gray, paper white, glyphset 0
    for (int i = 0; i < SCR_ROWS * SCR_COLS; i++)
    {
        // If the real font makes space empty,
        // inversion paints the complete paper cell.
        paperRAM[i] = 0x20;

        charRAM[i] = 0x20;

        attrRAM[i] = 0;

        // Equivalent explicit form:
        // attrRAM[i] =
        //     (uint8_t)((0 << 6) | (0 << 4) | 1);
        //
        // glyphset 0, paper 0, ink DARKGRAY index 1
    }

    // Fill the rest with varying attributes
    // to prove the mapping.
    for (int y = 1; y < SCR_ROWS; y++)
    {
        for (int x = 0; x < SCR_COLS; x++)
        {
            uint8_t gs =
            (uint8_t)((x >> 4) & 3);

            uint8_t p2 =
            (uint8_t)(y & 3);

            uint8_t i4 =
            (uint8_t)(x & 0x0F);

            // Space inversion paints paper
            // across the whole cell.
            uint8_t paperGlyph = 0x20;

            uint8_t inkGlyph =
            (uint8_t)((x + y) & 0x7F);

            setCell(
                x,
                y,
                paperGlyph,
                inkGlyph,
                gs,
                p2,
                i4);
        }
    }
}

// ===========================
// Arduino setup/loop
// ===========================

static uint32_t frameNo = 0;

void setup()
{
    Serial.begin(115200);
    delay(50);

    initPalette256();
    initScreenRAM();

    gfx->begin();
    gfx->fillScreen(0x0000);

    #ifdef GFX_BL
    // pinMode(GFX_BL, OUTPUT);
    // digitalWrite(GFX_BL, HIGH);

    pinMode(GFX_BL, OUTPUT);
    analogWrite(GFX_BL, 100); // 0–255
    #endif

    gxp = new GfxCompat(gfx);
}

void loop()
{
    frameNo++;

    // Tiny animated proof in row 0.
    int x =
    (frameNo / 2) % SCR_COLS;

    setCell(
        x,
        0,
        0x20,
        (uint8_t)('0' + (frameNo % 10)),
            (frameNo >> 6) & 3,
            (frameNo >> 4) & 3,
            frameNo & 0x0F);

    renderFullScreen(*gxp);

    // Remove delay when benchmarking.
    delay(1000);
}
