10 REM 7XTGV PALETTE COMPARISON - CP/M MBASIC, 80X24
20 REM 0-9 SELECTS AND LAZILY SAVES THE TERMINAL PALETTE
30 REM OPTIONAL VTPAL.INI EXCERPT DEFINES BACKGROUND LEVELS 3-6
35 REM WIDTH 255 DISABLES BASIC WRAPPING INSIDE TERMINAL ESCAPES
40 WIDTH 255:DEFINT A-Z:DIM N$(7),F(7),B(3),P$(3)
50 E$=CHR$(27):PG=0:PA=0:BP=0
60 FOR J=0 TO 7:READ N$(J),F(J):NEXT J
70 DATA INK,30,RED,31,GREEN,32,BLUE,34
80 DATA SILVER,37,CYAN,36,MAGENTA,35,YELLOW,33
90 FOR J=0 TO 3:READ P$(J),B(J):NEXT J
100 DATA BASE,47,RED,41,GREEN,42,BLUE,44
110 PRINT E$;"<";E$;"(B";E$;"[?25l";
120 GOSUB 800:GOSUB 1000
130 K$=INKEY$:IF K$="" THEN 130
140 IF K$>="0" AND K$<="9" THEN PA=ASC(K$)-48:GOSUB 800:GOTO 220
150 IF K$="P" OR K$="p" THEN PG=0:GOTO 220
160 IF K$="I" OR K$="i" THEN PG=1:GOTO 220
170 IF K$="B" OR K$="b" THEN BP=(BP+1) MOD 4:GOTO 220
180 IF K$="R" OR K$="r" THEN 220
190 IF K$="Q" OR K$="q" THEN 900
200 GOTO 130
220 GOSUB 1000:GOTO 130
800 REM SELECT PRESET; STR$ LEADING SPACE MUST NOT ENTER CSI
810 PRINT E$;"[>69;";MID$(STR$(PA),2);"v";
820 RETURN
900 PRINT E$;"[0m";E$;"[?25h";E$;"[2J";E$;"[H";
910 PRINT "Palette";PA;"retained. Back in MBASIC.":END
1000 PRINT E$;"[0m";E$;"[2J";E$;"[H";
1010 IF PG=0 THEN PRINT "VTPAL: ALL INKS ON FOUR PAPERS";
1020 IF PG=1 THEN PRINT "VTPAL: NORMAL / ALT INK PAIRS";
1030 PRINT "  PRESET";PA;
1040 R=2:C=1:GOSUB 7000
1050 PRINT "0 PAPER | GREEN 1/3/4 | AMBER 2/5/6 (optional levels)";
1060 IF PG=0 THEN GOSUB 2000 ELSE GOSUB 3000
1070 R=21:C=1:GOSUB 7000:PRINT E$;"[0m";
1080 PRINT "Levels: base / lighter / lightest; 3-6 need INI additions.";
1090 R=22:C=1:GOSUB 7000
1100 PRINT "P Papers  I Inks  B Paper  0-9 Preset  R Redraw  Q BASIC";
1110 R=23:C=1:GOSUB 7000
1120 PRINT "Selection is saved by terminal. Choose preferred preset last.";
1130 RETURN
2000 REM MATRIX: NATIVE INK ORDER, NORMAL 0-7 THEN ALT 8-15
2010 R=3:C=1:GOSUB 7000:PRINT "INK / PAPER";
2020 FOR J=0 TO 3
2030 C=18+J*15:GOSUB 7000:PRINT P$(J);:NEXT J
2040 FOR A=0 TO 15
2050 H=A MOD 8:R=4+A:C=1:GOSUB 7000:PRINT E$;"[0m";
2060 IF A<8 THEN PRINT "NORMAL "; ELSE PRINT "ALT ";
2070 PRINT N$(H);
2080 FG=F(H):IF A>7 THEN FG=FG+60
2090 FOR J=0 TO 3:C=18+J*15:GOSUB 7000:BG=B(J)
2100 GOSUB 7100:PRINT " Aa09{}[]+-= ";:NEXT J
2110 NEXT A:PRINT E$;"[0m";:RETURN
3000 REM SAME GLYPHS SIDE BY SIDE, ONE SELECTABLE PAPER
3010 R=3:C=1:GOSUB 7000
3020 PRINT "PAPER: ";P$(BP);"    NORMAL                  ALT";
3030 BG=B(BP)
3040 FOR H=0 TO 7
3050 R=4+H*2:C=1:GOSUB 7000:PRINT E$;"[0m";N$(H);
3060 C=18:GOSUB 7000:FG=F(H):GOSUB 7100
3070 PRINT " Aa09 {}[] +-= ijMW ";
3080 C=43:GOSUB 7000:FG=F(H)+60:GOSUB 7100
3090 PRINT " Aa09 {}[] +-= ijMW ";
3100 NEXT H:PRINT E$;"[0m";:RETURN
7000 PRINT E$;"[";MID$(STR$(R),2);";";MID$(STR$(C),2);"H";
7010 RETURN
7100 PRINT E$;"[0;";MID$(STR$(FG),2);";";
7110 PRINT MID$(STR$(BG),2);"m";:RETURN
