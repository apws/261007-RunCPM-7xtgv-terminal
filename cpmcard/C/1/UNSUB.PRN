

                ; UNSUB.COM -- remove a stranded CP/M SUBMIT queue from the current DU.
                ; The zero-drive FCB and current BDOS user are intentionally left unchanged.
                
 0100                   org     0100h
                
 0005 =         bdos    equ     5
 0013 =         delete  equ     19
                
 0100 110901    start:  lxi     d,fcb
 0103 0E13              mvi     c,delete
 0105 CD0500            call    bdos
 0108 C9                ret
                
 0109 0024242420fcb:    db      0,'$$$     ','SUB'
 0115                   ds      24
                
 012D                   end     start
