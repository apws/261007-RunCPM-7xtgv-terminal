; VTDRV.COM - sequential CP/M drive-path benchmark for RunCPM.
; Requires the 7xtgv RunCPM host timer on private I/O port 7Ah.
;
; Plain VTDRV only reads and verifies the existing 32 KiB VTDRV.$$$ file.
; VTDRV W explicitly recreates that file before reading it (RW is an alias).
; Q pauses the terminal task for timed passes: Q reads only; W Q writes/reads.
; Timed passes include CP/M BDOS calls and RunCPM's complete host
; filesystem/SD path.  Console output is outside them.

        org     0100h

port:   equ     07ah
qport:  equ     07eh
bdos:   equ     0005h

print:  equ     9
open:   equ     15
close:  equ     16
delete: equ     19
read:   equ     20
write:  equ     21
make:   equ     22
setdma: equ     26

wbegin: equ     1
wend:   equ     2
rbegin: equ     3
rend:   equ     4
qbegin: equ     9
qend:   equ     10
qwbegin: equ    11
qwend: equ      12
cancel: equ     255

records: equ    256
fcblen: equ     36

        in      a,(port)
        cp      'D'
        jp      nz,unsupported

        ld      de,banner
        ld      c,print
        call    bdos
        call    parse_mode
        cp      0ffh
        jp      z,bad_option
        and     2
        jr      z,mode_ready
        in      a,(qport)
        cp      'B'
        jr      z,mode_ready
        cp      'Q'
        jp      nz,quiet_unsupported
        ld      a,(mode_flags)
        and     1
        jp      nz,quiet_unsupported
mode_ready:
        ld      a,(mode_flags)
        and     1
        jp      z,read_pass

; Explicit W mode starts here. Q uses quiet timing for both passes.
        call    fill_buffer

; Remove a stale file from an interrupted earlier run.
        call    prepare_fcb
        ld      de,fcb
        ld      c,delete
        call    bdos

; Timed create/write/close pass.
        ld      a,(mode_flags)
        and     2
        ld      a,wbegin
        jr      z,write_start
        ld      a,qwbegin
write_start:
        out     (port),a
        call    prepare_fcb
        ld      de,fcb
        ld      c,make
        call    bdos
        cp      0ffh
        jp      z,write_error
        call    set_dma
        ld      hl,records
        ld      (count),hl
write_loop:
        ld      de,fcb
        ld      c,write
        call    bdos
        or      a
        jp      nz,write_error
        call    count_down
        jr      nz,write_loop
        ld      de,fcb
        ld      c,close
        call    bdos
        cp      0ffh
        jp      z,write_error
        ld      a,(mode_flags)
        and     2
        ld      a,wend
        jr      z,write_end
        ld      a,qwend
write_end:
        out     (port),a
        jp      read_pass

; Timed open/read/close pass.  Verification is deliberately separate so its
; interpreted byte-comparison loop does not distort the drive rate.
read_pass:
        call    set_dma
        ld      a,(mode_flags)
        and     2
        ld      a,rbegin
        jr      z,read_start
        ld      a,qbegin
read_start:
        out     (port),a
        call    open_for_read
        jp      z,read_error
        ld      hl,records
        ld      (count),hl
read_loop:
        ld      de,fcb
        ld      c,read
        call    bdos
        or      a
        jp      nz,read_error
        call    count_down
        jr      nz,read_loop
        ld      de,fcb
        ld      c,close
        call    bdos
        cp      0ffh
        jp      z,read_error
        ld      a,(mode_flags)
        and     2
        ld      a,rend
        jr      z,read_end
        ld      a,qend
read_end:
        out     (port),a

; Untimed full verification pass.
        call    open_for_read
        jr      z,verify_read_error
        ld      hl,records
        ld      (count),hl
verify_record:
        ld      de,fcb
        ld      c,read
        call    bdos
        or      a
        jr      nz,verify_read_error
        call    check_buffer
        jr      nz,verify_data_error
        call    count_down
        jr      nz,verify_record
        ld      de,fcb
        ld      c,read
        call    bdos
        cp      1
        jr      nz,verify_eof_error
        ld      de,fcb
        ld      c,close
        call    bdos

        ld      de,passed
        ld      c,print
        call    bdos
        jp      0

bad_option:
        ld      de,usage_message
        jr      show_and_exit

unsupported:
        ld      de,unsupported_message
        jr      show_and_exit

quiet_unsupported:
        ld      de,qneedmsg
        jr      show_and_exit

write_error:
        ld      a,cancel
        out     (port),a
        ld      de,write_message
        push    de
        call    remove_file
        pop     de
        jr      show_and_exit

read_error:
        ld      a,cancel
        out     (port),a
        ld      de,read_message
        jr      failed

verify_read_error:
        ld      de,verify_read_message
        jr      failed
verify_data_error:
        ld      de,verify_data_message
        jr      failed
verify_eof_error:
        ld      de,verify_eof_message
failed:
show_and_exit:
        ld      c,print
        call    bdos
        jp      0

prepare_fcb:
        ld      hl,fcb_template
        ld      de,fcb
        ld      b,fcblen
copy_fcb:
        ld      a,(hl)
        ld      (de),a
        inc     hl
        inc     de
        djnz    copy_fcb
        ret

; Return bit 0 for W/RW, bit 1 for Q, FF for malformed or duplicate options.
; CP/M's tail is length-prefixed, not NUL-terminated. Require token boundaries.
parse_mode:
        xor     a
        ld      (mode_flags),a
        ld      a,(0080h)
        ld      b,a
        ld      hl,0081h
pm_skip:
        ld      a,b
        or      a
        jp      z,pm_done
        ld      a,(hl)
        cp      ' '
        jr      nz,pm_token
        inc     hl
        dec     b
        jr      pm_skip
pm_token:
        cp      '/'
        jr      nz,pm_letter
        inc     hl
        dec     b
        jp      z,pm_bad
        ld      a,(hl)
pm_letter:
        and     05fh
        cp      'W'
        jr      z,pm_w
        cp      'Q'
        jr      z,pm_q
        cp      'R'
        jr      nz,pm_bad
        inc     hl
        dec     b
        jp      z,pm_bad
        ld      a,(hl)
        and     05fh
        cp      'W'
        jr      nz,pm_bad
pm_w:
        ld      a,(mode_flags)
        and     1
        jr      nz,pm_bad
        ld      a,(mode_flags)
        or      1
        ld      (mode_flags),a
        jr      pm_after
pm_q:
        ld      a,(mode_flags)
        and     2
        jr      nz,pm_bad
        ld      a,(mode_flags)
        or      2
        ld      (mode_flags),a
pm_after:
        inc     hl
        dec     b
        jr      z,pm_done
        ld      a,(hl)
        cp      ' '
        jr      nz,pm_bad
        jr      pm_skip
pm_done:
        ld      a,(mode_flags)
        ret
pm_bad:
        ld      a,0ffh
        ret

open_for_read:
        call    prepare_fcb
        ld      de,fcb
        ld      c,open
        call    bdos
        cp      0ffh
        ret

set_dma:
        ld      de,buffer
        ld      c,setdma
        jp      bdos

count_down:
        ld      hl,(count)
        dec     hl
        ld      (count),hl
        ld      a,h
        or      l
        ret

fill_buffer:
        ld      hl,buffer
        ld      b,128
        xor     a
fill_byte:
        ld      (hl),a
        inc     hl
        inc     a
        djnz    fill_byte
        ret

check_buffer:
        ld      hl,buffer
        ld      b,128
        xor     a
check_byte:
        cp      (hl)
        ret     nz
        inc     hl
        inc     a
        djnz    check_byte
        xor     a                   ; successful full record: return Z
        ret

remove_file:
        call    prepare_fcb
        ld      de,fcb
        ld      c,delete
        jp      bdos

banner:
        db      'VTDRV: 32 KiB BDOS test; default read-only',13,10,'$'
usage_message:
        db      'Usage: VTDRV [W] [Q] (RW alias)',13,10,'$'
passed:
        db      'VTDRV verify: PASS',13,10,'$'
unsupported_message:
        db      'VTDRV needs newer 7xtgv RunCPM firmware.',13,10,'$'
qneedmsg:
        db      'VTDRV Q needs newer 7xtgv RunCPM firmware.',13,10,'$'
write_message:
        db      'VTDRV write failed.',13,10,'$'
read_message:
        db      'VTDRV read failed; run VTDRV W once at safe speed.',13,10,'$'
verify_read_message:
        db      'VTDRV verify read failed.',13,10,'$'
verify_data_message:
        db      'VTDRV verify data failed.',13,10,'$'
verify_eof_message:
        db      'VTDRV verify EOF failed.',13,10,'$'

fcb_template:
        db      0,'VTDRV   ','$$$'
        ds      24,0
fcb:    ds      fcblen,0
count:  dw      0
mode_flags: db   0
buffer: ds      128,0
