>x8808\x
>;7xtgv KBD SEMANTIC CONTROL
>; - main 16 special keys on keyboard
>    =up 1=left 2=down 3=right
>;   4=pgdn 5=pgup 6=end 7=home 8=del 9=ins
>;   A=tab B=space C=escapeeteert D=backspace E=enter F=context/xx
>; - general modifiers: ctrl shift altaas upper nibble +0x80s lower nibble 
>;   80 = no modifier
>90 = 1001 =;   1000 = 
>;   A0 = 1010 =
>; = 1011 =
>;   C = 1100 =
>;   D = 1101 =
>;   E = 1110 =
>;   F = 1111 =
>CCTRL+SHIFT+ALTCTRL+ALTCTRL+SHIFTSHIFTTRL; ALT+SHALT
>;; - "SIMPLEST ONE-BYTE" CONTROL FOR 7xtgv-terminal  MAIN KEYS
