; 7xtgv terminal config

[display:ES3_5]
view_zoom=2
zoom1_terminal=132x48
zoom2_terminal=80x24
zoom3_terminal=44x16
zoom4_terminal=32x12
render_flush_hz=10

[display:ES3_35]
view_zoom=1
zoom1_terminal=80x32
zoom2_terminal=40x16
zoom3_terminal=26x10
zoom4_terminal=20x8
render_flush_hz=10

[display:RP2_2]
view_zoom=1
zoom1_terminal=80x24
zoom2_terminal=40x12
zoom3_terminal=26x8
zoom4_terminal=20x6
render_flush_hz=0

[global]
backlight_level=16
cursor_blink_ms=250
console_bits=8

mode=ansi
; Global theme: 0=PAPER, 1=GREEN, 2=AMBER. Runtime: VTPAL 0..9.
mode_palette=0

;unified exit and cls .... but that ralt isnt there now, ALT+ESC, ALT+BS
exit_key=lalt+ralt+escape
clear_key=lalt+ralt+delete

; UI colors follow the selected palette; explicit RGB overrides it.
viewport_gutter_rgb=palette
viewport_active_gutter_rgb=palette

; Editable palettes: decimal R,G,B (0..255), no inline comments.
; Slots are independent; omitted values retain built-in PAPER defaults.
; Ink 00..07 = normal, 08..15 = same hues with emphasis (bit 3).
; Hue order: grey, red, green, blue, silver, cyan, magenta, yellow.
; Palette UI colors are inherited by banks with *_rgb=palette.
[palette0]
; PAPER: unchanged original terminal colors
paper0=255,255,255
paper1=255,230,235
paper2=205,255,205
paper3=240,240,255
ink00=100,100,100
ink01=255,0,0
ink02=0,242,0
ink03=0,0,255
ink04=230,230,230
ink05=76,242,242
ink06=255,80,255
ink07=230,230,50
ink08=0,0,0
ink09=231,37,37
ink10=21,200,47
ink11=37,89,221
ink12=215,215,215
ink13=0,184,194
ink14=205,47,189
ink15=200,194,0
active_line_rgb=205,255,205
cursor_rgb=0,150,40
viewport_gutter_rgb=128,128,128
viewport_active_gutter_rgb=active_line

[palette1]
; GREEN: provisional dark theme, named colored inks remain colored.
paper0=0,12,0
paper1=40,12,12
paper2=0,40,8
paper3=12,20,44
ink00=100,210,100
ink01=231,37,37
ink02=21,200,47
ink03=0,0,255
ink04=140,160,140
ink05=0,184,194
ink06=205,47,189
ink07=200,194,0
ink08=170,255,170
ink09=255,0,0
ink10=0,242,0
ink11=37,89,221
ink12=215,235,215
ink13=76,242,242
ink14=255,80,255
ink15=230,230,50
active_line_rgb=0,40,8
cursor_rgb=50,120,50
viewport_gutter_rgb=20,45,20
viewport_active_gutter_rgb=active_line

[palette2]
; AMBER: provisional dark theme, ready for visual tuning.
paper0=16,8,0
paper1=44,16,8
paper2=20,36,8
paper3=20,20,40
ink00=220,155,45
ink01=231,37,37
ink02=21,200,47
ink03=0,0,255
ink04=165,150,120
ink05=0,184,194
ink06=205,47,189
ink07=200,194,0
ink08=255,205,100
ink09=255,0,0
ink10=0,242,0
ink11=37,89,221
ink12=235,220,190
ink13=76,242,242
ink14=255,80,255
ink15=230,230,50
active_line_rgb=48,28,0
cursor_rgb=130,80,10
viewport_gutter_rgb=55,35,10
viewport_active_gutter_rgb=active_line

; Spare slots: copy/edit palette0 entries here when needed.
[palette3]
[palette4]
[palette5]
[palette6]
[palette7]
[palette8]
[palette9]


; 7xtgv application profiles. Loaded once at boot from A/0/7XTGVTRM.INI.

[bank0]
name=A0: CCP
; Inactive defaults below: remove ';' and edit only to override.
; mode inherits [global]; zoom geometry inherits [display:HALID].
; Replace COLSxROWS before enabling any zoomN_terminal line.
; RunCPM CCP editor; Ctrl motions are from firmware bank defaults.
; Ctrl or Shift combos for cursor and sixpack

; mode=ansi
; input=custom

; zoom1_terminal=COLSxROWS
; zoom2_terminal=COLSxROWS
; zoom3_terminal=COLSxROWS
; zoom4_terminal=COLSxROWS

active_line_rgb=palette
cursor_rgb=palette

; exit_command=
clear_command=CLS\r

on_select=A0:\r

;cursor
left=send:\x01
right=send:\x06
up=history_previous
down=history_next

up_alt=send:\e[A
down_alt=send:\e[B

insert=send:\x16
delete=send:\x07
home=send:\x02
end=send:\x17
page_up=send:\e
page_down=send:\e

; Omitted key mappings from firmware defaults:
; left_ctrl=send:\x11\x02
; right_ctrl=send:\x11\x17
; home_ctrl=send:\x11\x18
; end_ctrl=send:\x11\x0b
; delete_ctrl=send:\x0b
; insert_ctrl=send:\x11\x05


[bank1]
name=A7: MBASIC
; Inactive defaults below: remove ';' and edit only to override.
; mode inherits [global]; zoom geometry inherits [display:HALID].
; Replace COLSxROWS before enabling any zoomN_terminal line.
; MBASIC; INI local_compose overrides the native adapter fallback.
; Ctrl or Shift combos for cursor and sixpack

;editor
screen_line=true
escape_cancels=true
input_adapter=local_compose
command_new_line=true

;cursor colors
active_line_rgb=palette
cursor_rgb=palette

;unified exit and cls
exit_command=system\r
clear_command=print chr$(27);"[2J";chr$(27);"[H"\r

;action
on_select=A7:\r

;cursors
left=send:\x08
right=send:\x20
up=history_previous
down=history_next

up_alt=none
down_alt=none

;sixpack
insert=none
delete=send:1D
home=send:L
end=send:X\e
page_up=none
page_down=none


[bank2]
name=TE (wordstar)
; Inactive defaults below: remove ';' and edit only to override.
; mode inherits [global]; zoom geometry inherits [display:HALID].
; Replace COLSxROWS before enabling any zoomN_terminal line.
; TE v1.11 help; custom WordStar-like keys, not the generic preset.
; Ctrl or Shift combos for cursor and sixpack

;editor
editing_surface=screen

;cursor colors
active_line_rgb=palette
cursor_rgb=palette

;action
on_select=

;cursor
left=send:\x13
right=send:\x04
up=send:\x05
down=send:\x18

up_alt=history_previous
down_alt=history_next

;sixpack
insert=none
delete=send:\x07
home=send:\x11S
end=send:\x11D
page_up=send:\x12
page_down=send:\x03



[bank3]
name=A2: TP301
; Inactive defaults below: remove ';' and edit only to override.
; mode inherits [global]; zoom geometry inherits [display:HALID].
; Replace COLSxROWS before enabling any zoomN_terminal line.
; Turbo Pascal; modifier fallbacks use ANSI sequences.
; Ctrl or Shift combos for cursor and sixpack

;editor
editing_surface=screen

;cursor colors
active_line_rgb = palette
cursor_rgb = palette

;unified exit and cls
;in fact, here used to be sent to exit screen editor like "end edit"
; - it MAY work also as Quit from app ???
exit_command=Q
;clear_command=print chr$(27);"[2J";chr$(27);"[H"\r

;action
on_select=A2:\r


;cursor

left=send:\x81
left_shift=send:\x91
left_ctrl=send:\xc1
;left_alt=send:\xa1

right=send:\x83
right_shift=send:\x93
right_ctrl=send:\xc3
;right_alt=send:\xa3

up=send:\x80
up_shift=send:\x90
up_ctrl=send:\xc0
;up_alt=send:\xa0
up_alt=history_previous

down=send:\x82
down_shift=send:\x92
down_ctrl=send:\xc2
;down_alt=send:\xa2
down_alt=history_next


; ~
; 7xtgv KBD CORE KEYS CONTROL
;
; - PHOTO OF PC-104 KBD WITH CORE KEYS 0-F RED MARKED
;
; - main 16 special keys on keyboard as lower nibble
;   0=up 1=left 2=down 3=right
;   4=pgdn 5=pgup 6=end 7=home 8=delete 9=insert
;   A=tab B=space C=escape D=backspace E=enter F=context/x/&
;   as F is probably best THE "|\&*" key next to CTRL+SHIFT !!!
;
; - general modifiers: CTRL SHIFT ALT as upper nibble +0x80
;   8 = 1000 = no modifier
;
;   9 = 1001 = SHIFT
;   A = 1010 = ALT
;   B = 1011 = ALT+SHIFT
;   C = 1100 = CTRL
;   D = 1101 = CTRL+SHIFT
;   E = 1110 = CTRL+ALT
;   F = 1111 = CTRL+SHIFT+ALT
;
; - "SIMPLEST ONE-BYTE" CONTROL FOR 7xtgv-terminal MAIN KEYS
;

;sixpack

insert=send:\x89
insert_shift=send:\x99
insert_ctrl=send:\xc9
insert_alt=send:\xa9

delete=send:\x88
delete_shift=send:\x98
delete_ctrl=send:\xc8
delete_alt=send:\xa8

home=send:\x87
home_shift=send:\x97
home_ctrl=send:\xc7
home_alt=send:\xa7

end=send:\x86
end_shift=send:\x96
end_ctrl=send:\xc6
end_alt=send:\xa6

page_up=send:\x85
page_up_shift=send:\x95
page_up_ctrl=send:\xc5
page_up_alt=send:\xa5

page_down=send:\x84
page_down_shift=send:\x94
page_down_ctrl=send:\xc4
page_down_alt=send:\xa4

z1_ctrl=send:\xcF
z1_ctrl_shift=send:\xdF

escape=send:\^K\^D

;expertimental CTRL+S as "quick save" (TP)
s_ctrl=send:\^K\^DSE\^Q\^P



;proposed in-app "filtered keywords completions" switching
;in fact this will dynamically switch behavior of up/dn and ALT+up/dn
;as in-app line-prompt can use up/dn but "screen" must use ALT for that

;home_alt=keywords_previous - this in fact generalizes history_prev
;end_alt=keywords_next      - this in fact generalizes history_next



[bank4]
name=A3: COMAL
; Inactive defaults below: remove ';' and edit only to override.
; mode inherits [global]; zoom geometry inherits [display:HALID].
; Replace COLSxROWS before enabling any zoomN_terminal line.
; COMAL; modifier fallbacks use ANSI sequences.
; Ctrl or Shift combos for cursor and sixpack

;cursor colors
active_line_rgb=palette
cursor_rgb=palette

;unified exit and cls
exit_command=BYE\r
clear_command=PAGE\r

;action
on_select=A3:\r

;cursor
left=send:\e[D
right=send:\e[C
up=send:\e[A
down=send:\e[B

up_alt=history_previous
down_alt=history_next

;sixpac
home=send:\e[H
end=send:\e[F
insert=send:\e[2~
delete=send:\e[3~
page_up=send:\e[5~
page_down=send:\e[6~


[bank5]
name=A1: BBC BASIC
; Inactive defaults below: remove ';' and edit only to override.
; mode inherits [global]; zoom geometry inherits [display:HALID].
; Replace COLSxROWS before enabling any zoomN_terminal line.
; BBC DIST.Z80 for base keys; modifiers use ANSI fallbacks.
; Ctrl or Shift combos for cursor and sixpack

;editor
editing_surface=line
screen_line=true
trim_left=true
line_prefix=>
activate_prefix=>
activate_numbered_line=true
escape_cancels=true

;cursor colors
active_line_rgb=palette
cursor_rgb=palette

;unified exit and cls
exit_command=quit\r
clear_command=print chr$(27);"[2J";chr$(27);"[H"\r

;action
on_select=A1:\r

;cursor
left=send:\x0a
right=send:\x0c
up=history_previous
down=history_next

up_alt=send:\x07
down_alt=send:\x0f

;sixpack
insert=send:\x11
delete=send:\x12
home=send:\x06
end=send:\x0e
page_up=send:\e[5~
page_down=send:\e[6~

;history - but WHY ONLY HERE when it is in fact GLOBAL ????
history_clear=\x06\x18
history_retype_delay_ms=100

[bank6]
name=DDT
; Inactive defaults below: remove ';' and edit only to override.
; mode inherits [global]; zoom geometry inherits [display:HALID].
; Replace COLSxROWS before enabling any zoomN_terminal line.
; DDT; missing navigation bindings are inactive.

;cursor colors
active_line_rgb=palette
cursor_rgb=palette

;action
on_select=

;cursor
left=none
right=none
up=history_previous
down=history_next

up_alt=none
down_alt=none

;sixpack
home=none
end=none
insert=none
delete=none
page_up=none
page_down=none


[bank7]
name=A15: FAND

;no this is BAD (vt52 defines only cursors, wordstar nothing well??)
;!!! main purpose of this input= is to MAP physical [Ctrl+]cursors/sixpack
;!!! BUT IT IS NOT COMPLETE !!! - these defaults MUST BE  opinionated !!!
;input=vt52
;input=wordstar

;editor
editing_surface=screen

;cursor colors
active_line_rgb=palette
cursor_rgb=palette

;unified exit and cls
exit_command=^K^D\e
clear_command=

;action
on_select=A15:\r


;CURSOR
;TE settings tried here, overrides for "wordstar" input (it seems DONT work)
; key-first chord names: right_ctrl, delete_ctrl_shift, etc.

left=send:\^S
left_ctrl=send:\^A

right=send:\^D
right_ctrl=send:\^F

up=send:\^E
up_ctrl=send:\^W
up_alt=history_previous

down=send:\^X
down_ctrl=send:\^Z
down_alt=history_next


;SIXPACK
insert=send:\^V
insert_ctrl=send:\x0e

delete=send:\^G
;delete=send:\x07
;delete=send:\e[3


delete_ctrl=send:\^Q\^Y
delete_shift=send:\^Y
delete_ctrl_shift=send:\^T

home=send:\^Q\^S
home_ctrl=send:\^Q\^R
home_shift=send:\^Q\^B

end=send:\^Q\^D
end_ctrl=send:\^Q\^C
end_shift=send:\^Q\^K

page_up=send:\^R
page_up_ctrl=send:\^Q\^E

page_down=send:\^C
page_down_ctrl=send:\^Q\^X

;expertimental CTRL+S as "quick save" (FAND)
s_ctrl=send:\^K\^S




