# Konsole translation of the 7xtgv CP/M/WordStar-style Kitty mappings.
keyboard "7xtgv CP/M"

key Left      -Shift-Alt-Ctrl : "\E[>30v"
key Right     -Shift-Alt-Ctrl : "\E[>31v"
key Up        -Shift-Alt-Ctrl : "\E[>36v"
key Down      -Shift-Alt-Ctrl : "\E[>37v"

key PgUp      -Shift-Alt-Ctrl : "\E[>40v"
key PgDown    -Shift-Alt-Ctrl : "\E[>41v"

key Home      -Shift-Alt-Ctrl : "\E[>32v"
key End       -Shift-Alt-Ctrl : "\E[>33v"
key Left      -Shift-Alt+Ctrl : "\E[>42v"
key Right     -Shift-Alt+Ctrl : "\E[>43v"
key Up        -Shift-Alt+Ctrl : "\E[>44v"
key Down      -Shift-Alt+Ctrl : "\E[>45v"

key Home      -Shift-Alt+Ctrl : "\E[>46v"
key End       -Shift-Alt+Ctrl : "\E[>47v"
key Delete    -Shift-Alt+Ctrl : "\E[>48v"
key Insert    -Shift-Alt+Ctrl : "\E[>49v"
key PgUp      -Shift-Alt+Ctrl : "\E[>50v"
key PgDown    -Shift-Alt+Ctrl : "\E[>51v"
key Backspace -Shift-Alt+Ctrl : "\x18"
key Backspace +Shift-Alt+Ctrl : "\E[>65v"

# Global compact-viewport edge jumps. These bypass the active application
# profile and are handled before its profile-specific key bindings.
key Home      +Shift-Alt+Ctrl : "\E[1;3H"
key End       +Shift-Alt+Ctrl : "\E[1;3F"
key Home      +Shift+Alt-Ctrl : "\E[1;3H"
key End       +Shift+Alt-Ctrl : "\E[1;3F"

# Global backlight: Ctrl+Shift and Alt+Shift are equivalent single-chord
# front ends for the private CSI >63;n control (0=off, 1..9=10..90%).
key PgUp      +Shift-Alt+Ctrl : "\E[>63;10v"
key PgDown    +Shift-Alt+Ctrl : "\E[>63;11v"
key PgUp      +Shift+Alt-Ctrl : "\E[>63;10v"
key PgDown    +Shift+Alt-Ctrl : "\E[>63;11v"
key 0         +Shift-Alt+Ctrl : "\E[>63;0v"
key 1         +Shift-Alt+Ctrl : "\E[>63;1v"
key 2         +Shift-Alt+Ctrl : "\E[>63;2v"
key 3         +Shift-Alt+Ctrl : "\E[>63;3v"
key 4         +Shift-Alt+Ctrl : "\E[>63;4v"
key 5         +Shift-Alt+Ctrl : "\E[>63;5v"
key 6         +Shift-Alt+Ctrl : "\E[>63;6v"
key 7         +Shift-Alt+Ctrl : "\E[>63;7v"
key 8         +Shift-Alt+Ctrl : "\E[>63;8v"
key 9         +Shift-Alt+Ctrl : "\E[>63;9v"
key 0         +Shift+Alt-Ctrl : "\E[>63;0v"
key 1         +Shift+Alt-Ctrl : "\E[>63;1v"
key 2         +Shift+Alt-Ctrl : "\E[>63;2v"
key 3         +Shift+Alt-Ctrl : "\E[>63;3v"
key 4         +Shift+Alt-Ctrl : "\E[>63;4v"
key 5         +Shift+Alt-Ctrl : "\E[>63;5v"
key 6         +Shift+Alt-Ctrl : "\E[>63;6v"
key 7         +Shift+Alt-Ctrl : "\E[>63;7v"
key 8         +Shift+Alt-Ctrl : "\E[>63;8v"
key 9         +Shift+Alt-Ctrl : "\E[>63;9v"

key Delete    -Shift-Alt-Ctrl : "\E[>34v"
key Insert    -Shift-Alt-Ctrl : "\E[>35v"
key F5        -Shift-Alt-Ctrl : "\x11\x46"

# PC fallback for the firmware's future exact Left-Alt + Right-Alt gestures.
key Escape     -Shift+Alt-Ctrl : "\E[>60v"
key Backspace  -Shift+Alt-Ctrl : "\E[>61v"
key Backspace  +Shift+Alt-Ctrl : "\E[>4v"

# Application-profile Alt keys. Viewport edge jumps are Ctrl+Shift+Home/End.
key Left      -Shift+Alt-Ctrl : "\E[>52v"
key Right     -Shift+Alt-Ctrl : "\E[>53v"
key Home      -Shift+Alt-Ctrl : "\E[>54v"
key End       -Shift+Alt-Ctrl : "\E[>55v"
key Delete    -Shift+Alt-Ctrl : "\E[>56v"
key Insert    -Shift+Alt-Ctrl : "\E[>57v"

# 7xtgv local history: exactly one explicitly selected bank.
key Space     -Shift+Alt-Ctrl : "\E[>14v"
key 3         +Shift+Alt-Ctrl : "\E[>15v"
key Up        -Shift+Alt-Ctrl : "\E[>38v"
key Down      -Shift+Alt-Ctrl : "\E[>39v"
key PgUp      -Shift+Alt-Ctrl : "\E[>12v"
key PgDown    -Shift+Alt-Ctrl : "\E[>13v"
key 0         -Shift+Alt-Ctrl : "\E[>20v"
key 1         -Shift+Alt-Ctrl : "\E[>21v"
key 2         -Shift+Alt-Ctrl : "\E[>22v"
key 3         -Shift+Alt-Ctrl : "\E[>23v"
key 4         -Shift+Alt-Ctrl : "\E[>24v"
key 5         -Shift+Alt-Ctrl : "\E[>25v"
key 6         -Shift+Alt-Ctrl : "\E[>26v"
key 7         -Shift+Alt-Ctrl : "\E[>27v"
key 8         -Shift+Alt-Ctrl : "\E[>28v"
key 9         -Shift+Alt-Ctrl : "\E[>29v"
