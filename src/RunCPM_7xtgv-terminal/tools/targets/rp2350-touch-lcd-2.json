{
  "display_id": "RP2_2",
  "description": "RP2350 Waveshare Touch-LCD 2-inch",
  "port_globs": [
    "/dev/serial/by-id/usb-Generic_RP2350*-if00"
  ],
  "method": "bootsel-uf2",
  "profile": "rp2350-touch-lcd-2",
  "build_properties": {
    "build.extra_flags": "-DRUNCPM_TARGET_RP2350_TOUCH_LCD_2 -DXTGV_RUNCPM=1 -DXTGV_TERMINAL=1 -DXTGV_CCP_7XF=1 -DSPI_DRIVER_SELECT=3"
  }
}
